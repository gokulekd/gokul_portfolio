rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio content — public read, authenticated write
    match /site_sections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /page_configs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /social_links/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings (resume URL, etc.) — public read, authenticated write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media library metadata — public read, authenticated write
    match /media_assets/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact form — public write (visitors), authenticated read (admin)
    match /submissions/{docId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
