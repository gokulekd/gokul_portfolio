# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit real credentials.
#
# These are baked into the web build at compile time by build.sh.
# The anon key is safe to ship in a client build (it is gated by Supabase RLS),
# but keep it out of version control anyway.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# → "Generate key pair", then paste the PUBLIC key here. Required for admin push
# notifications (Settings → Notifications); the site works without it.
FCM_VAPID_KEY=YOUR_VAPID_PUBLIC_KEY
